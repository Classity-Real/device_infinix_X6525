# dm-verity is deliberately not requested for the dynamic partitions.
#
# The stock firmware keeps one chained vbmeta partition per Treble partition
# (vbmeta_system, vbmeta_vendor, vbmeta_odm, vbmeta_product, vbmeta_system_ext)
# and those only describe the stock super images. This tree builds its own super
# images and does not rebuild/refresh those chained vbmetas, so keeping
# avb=<name> here makes first-stage init fail the hash check and reboot before
# the boot animation ever starts.
#
# Bootloader-side verification of boot/vendor_boot/dtbo is disabled separately
# on the device; those images are signed with the AOSP testkey.
system /system erofs ro wait,logical,first_stage_mount,slotselect
system /system ext4 ro,barrier=1 wait,logical,first_stage_mount,slotselect
system_ext /system_ext erofs ro wait,logical,first_stage_mount,slotselect
vendor /vendor erofs ro wait,logical,first_stage_mount,slotselect
odm /odm erofs ro wait,logical,first_stage_mount,slotselect
product /product erofs ro wait,logical,first_stage_mount,slotselect
vendor_dlkm /vendor_dlkm erofs ro wait,logical,first_stage_mount,slotselect
/dev/block/by-name/tranfs /tranfs ext4 rw,noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc wait,check,formattable,nofail,first_stage_mount
/dev/block/by-name/metadata /metadata f2fs nodev,noatime,nosuid wait,formattable,first_stage_mount,check
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,errors=panic wait,formattable,first_stage_mount,check
