#
# System properties for Infinix Smart 8 (X6525 / ums9230).
#
# Seeded from the stock X6525 / Transsion ums9230 build.prop. Diff this against
# `tools/collect-props.py <dump>` output once you have extracted your own dump;
# anything that differs is a device-specific value you should keep.

# ART / Dalvik tuning
dalvik.vm.heapgrowthlimit=128m
dalvik.vm.heapsize=256m

# Stock is Android 13 Go edition and ships ro.config.low_ram=true, but this
# tree builds full LineageOS (not Go), where low_ram changes ActivityManager and
# graphics behaviour in ways the full build is not tested against. Keep it
# false unless you are porting the Go configuration properly.
ro.config.low_ram=false

# Misc
ro.dalvik.vm.native.bridge=0
